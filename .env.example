# Your ID, used in submission file names: letters and digits only
PARTICIPANT=P00

# Language model: anthropic or openrouter
LLM_PROVIDER=anthropic
# Required: the key for the provider you chose. The lab cannot run without one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
# Leave empty to pick a free model that accepts images (Gemma 4 first); lab check lists them.
OPENROUTER_MODEL=

# Local embedding model
EMBEDDING_BACKEND=sentence-transformers
# Same model as the primitives lab
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QUERY_PREFIX=
